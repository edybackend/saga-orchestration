{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Role": "All",
  "ConnectionStrings": {
    "Trips": "Data Source=data/trips.db",
    "Flights": "Data Source=data/flights.db",
    "Hotels": "Data Source=data/hotels.db",
    "Cars": "Data Source=data/cars.db"
  },
  "Participants": {
    "Flights": { "Capacity": 5 },
    "Hotels": { "Capacity": 2 },
    "Cars": { "Capacity": 2 }
  },
  "Saga": {
    "MaxAttempts": 4,
    "MaxCompensationAttempts": 20,
    "BaseBackoff": "00:00:01",
    "MaxBackoff": "00:00:30",
    "PollingInterval": "00:00:00.200",
    "CallTimeout": "00:00:03",
    "Participants": {
      "Flights": "http://localhost:8080",
      "Hotels": "http://localhost:8080",
      "Cars": "http://localhost:8080"
    }
  },
  "Samples": {
    "Seed": true
  }
}
